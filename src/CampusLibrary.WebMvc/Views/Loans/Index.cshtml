@model CampusLibrary.WebMvc.Models.Loans.LoanIndexViewModel
@{
    ViewData["Title"] = "Open Loans";
}

<div class="container py-4 metro-surface">
    @if (TempData["Success"] is { } success)
    {
        <div role="status" class="alert alert-success mb-3">@success</div>
    }
    @if (TempData["Error"] is { } error)
    {
        <div role="alert" class="alert alert-danger mb-3">@error</div>
    }
    <div class="metro-page-heading">
        <h1 class="metro-heading">Open loans</h1>
    </div>

    @if (!Model.OpenLoans.Any())
    {
        <div class="card metro-card mb-4">
            <div class="card-body text-center py-4">
                <p class="text-muted mb-0">There are no open loans.</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive" role="region" aria-label="Open loans" tabindex="0">
            <table class="table table-striped table-hover align-middle metro-table">
                <thead >
                    <tr>
                        <th scope="col">Book</th>
                        <th scope="col">Author</th>
                        <th scope="col">Member</th>
                        <th scope="col">Borrowed at</th>
                        <th scope="col" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.OpenLoans)
                    {
                        <tr>
                            <td>@loan.BookTitle</td>
                            <td>@loan.BookAuthor</td>
                            <td>@loan.MemberName</td>
                            <td>@loan.BorrowedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <form asp-action="Return" asp-route-id="@loan.LoanId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-metro btn-sm"
                                            onclick="return confirm('Mark this loan as returned?')">
                                        Return
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
