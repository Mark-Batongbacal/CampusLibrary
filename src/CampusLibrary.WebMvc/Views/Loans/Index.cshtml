@model CampusLibrary.WebMvc.Models.Loans.LoanIndexViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Open Loans";
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
}

<div class="container py-4">
    @if (TempData["Success"] is { } success)
    {
        <div class="alert alert-success mb-3">@success</div>
    }
    @if (TempData["Error"] is { } error)
    {
        <div class="alert alert-danger mb-3">@error</div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Open Loans</h1>
    </div>

    @if (!Model.OpenLoans.Any())
    {
        <div class="card mb-4">
            <div class="card-body text-center py-4">
                <p class="text-muted mb-0">There are no open loans.</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Book</th>
                        <th scope="col">Author</th>
                        <th scope="col">Member</th>
                        <th scope="col">Borrowed at</th>
                        <th scope="col" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.OpenLoans)
                    {
                        <tr>
                            <td>@loan.BookTitle</td>
                            <td>@loan.BookAuthor</td>
                            <td>@loan.MemberName</td>
                            <td>@loan.BorrowedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <form action="/Loans/Return/@loan.LoanId" method="post" class="d-inline">
                                    <input type="hidden" name="@antiforgeryTokens.FormFieldName" value="@antiforgeryTokens.RequestToken" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Mark this loan as returned?')">
                                        Return
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
