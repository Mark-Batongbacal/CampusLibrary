@model CampusLibrary.WebMvc.Models.Books.BookFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add book" : "Edit book";
}

<div class="container py-4 metro-surface">
    <div class="metro-page-heading">
        <h1 class="metro-heading">@ViewData["Title"]</h1>
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-metro">Back to books</a>
    </div>

    <div class="card metro-card metro-form">
        <div class="card-body">
            <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" novalidate>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Title</label>
                    <input asp-for="Title" class="form-control metro-input" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label">Author</label>
                    <input asp-for="Author" class="form-control metro-input" />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ISBN" class="form-label">ISBN</label>
                    <input asp-for="ISBN" class="form-control metro-input" />
                    <span asp-validation-for="ISBN" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AvailableCopies" class="form-label">Inventory copies</label>
                    <input asp-for="AvailableCopies" class="form-control metro-input" type="number" min="0" />
                    <span asp-validation-for="AvailableCopies" class="text-danger"></span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div role="alert" class="alert alert-danger metro-alert mb-3">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <button type="submit" class="btn btn-metro-accent">Save book</button>
            </form>
        </div>
    </div>
</div>
