@model CampusLibrary.WebMvc.Models.Books.BookIndexViewModel
@{
    ViewData["Title"] = "Books";
}

<div class="container py-4 metro-surface">
    @if (TempData["DeleteConflict"] is string deleteConflict)
    {
        <div role="alert" class="alert alert-danger metro-alert mb-3">
            @deleteConflict
        </div>
    }
    <div class="metro-page-heading">
        <h1 class="metro-heading">Books</h1>
        <a asp-controller="Books" asp-action="Create" class="btn btn-metro-accent">Add book</a>
    </div>

    @if (!Model.Books.Any())
    {
        <div class="card metro-card mb-4">
            <div class="card-body text-center py-4">
                <p class="text-muted mb-0">There are no books in the catalog.</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive" role="region" aria-label="Book catalog" tabindex="0">
            <table class="table table-striped table-hover align-middle metro-table metro-book-table">
                <thead >
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Author</th>
                        <th scope="col">ISBN</th>
                        <th scope="col" class="text-end">Inventory copies</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td>@book.Title</td>
                            <td>@book.Author</td>
                            <td>@book.ISBN</td>
                            <td class="text-end">@book.AvailableCopies</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-outline-metro btn-sm" aria-label="Edit @book.Title">Edit</a>
                                <form asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this book?')">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Delete @book.Title">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
