<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusLibrary</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="metro-topbar">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <a asp-controller="Home" asp-action="Index" class="metro-brand">CampusLibrary</a>
            <nav class="d-none d-md-flex gap-2" aria-label="Main navigation">
                <a class="metro-nav-link" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Books" ? "page" : null)" asp-controller="Books" asp-action="Index">Books</a>
                <a class="metro-nav-link" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Members" ? "page" : null)" asp-controller="Members" asp-action="Index">Members</a>
                <a class="metro-nav-link" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Loans" ? "page" : null)" asp-controller="Loans" asp-action="Index">Loans</a>
            </nav>
            <div class="d-flex gap-2">
                <a class="btn btn-metro-accent btn-sm" asp-controller="Books" asp-action="Create">Add book</a>
            </div>
        </div>
        <nav class="d-md-none d-flex justify-content-center p-2" aria-label="Mobile navigation">
            <a class="metro-nav-link" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Books" ? "page" : null)" asp-controller="Books" asp-action="Index">Books</a>
            <a class="metro-nav-link" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Members" ? "page" : null)" asp-controller="Members" asp-action="Index">Members</a>
            <a class="metro-nav-link" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Loans" ? "page" : null)" asp-controller="Loans" asp-action="Index">Loans</a>
        </nav>
    </header>

    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="metro-topbar mt-5">
        <div class="container d-flex justify-content-center py-3">
            <p class="m-0 text-secondary">CampusLibrary &mdash; librarian admin</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
