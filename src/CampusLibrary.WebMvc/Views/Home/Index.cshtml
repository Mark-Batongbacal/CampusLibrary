@{
    Layout = "_Layout";
    ViewData["Title"] = "Library workspace";
}

<div class="container py-4 metro-surface">
    <div class="metro-page-heading">
        <div>
            <h1 class="metro-heading">Library workspace</h1>
            <p class="metro-page-description">Manage the catalog, keep member records up to date, and process returns.</p>
        </div>
        <a asp-controller="Books" asp-action="Create" class="btn btn-metro-accent">Add book</a>
    </div>

    <section class="metro-workflow" aria-labelledby="catalog-heading">
        <div>
            <h2 id="catalog-heading">Books</h2>
            <p>@ViewData["BookCount"] books in the catalog. Review titles and update book information.</p>
        </div>
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-metro">Browse books</a>
    </section>
    <section class="metro-workflow" aria-labelledby="members-heading">
        <div>
            <h2 id="members-heading">Members</h2>
            <p>@ViewData["MemberCount"] registered members. View records and borrowing history.</p>
        </div>
        <a asp-controller="Members" asp-action="Index" class="btn btn-outline-metro">View members</a>
    </section>
    <section class="metro-workflow" aria-labelledby="loans-heading">
        <div>
            <h2 id="loans-heading">Open loans</h2>
            <p>@ViewData["OpenLoanCount"] loans currently out. Mark books as returned when they arrive.</p>
        </div>
        <a asp-controller="Loans" asp-action="Index" class="btn btn-outline-metro">Process returns</a>
    </section>
</div>
