@model CampusLibrary.WebMvc.Models.Members.CreateMemberViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Add member";
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
}

<div class="container py-4 metro-surface">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="metro-heading">Add member</h1>
        <a asp-controller="Members" asp-action="Index" class="btn btn-outline-metro">Back to members</a>
    </div>

    <div class="card metro-card">
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                <input type="hidden" name="@antiforgeryTokens.FormFieldName" value="@antiforgeryTokens.RequestToken" />

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full name</label>
                    <input asp-for="FullName" class="form-control metro-input" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control metro-input" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger metro-alert">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <button type="submit" class="btn btn-metro-accent">Add member</button>
            </form>
        </div>
    </div>
</div>

<style>
    .metro-surface { background: #000; color: #fff; border-radius: 8px; padding: 1.5rem; }
    .metro-surface a { color: #00f3ff; }
    .metro-surface .btn { color: #000; }
    .metro-heading { color: #00f3ff; font-weight: 700; letter-spacing: -0.5px; }
    .metro-card { background: #000; color: #fff; border: 1px solid #333; }
    .metro-card .card-body { color: #fff; }
    .metro-input { background: #111; color: #fff; border: 1px solid #00f3ff; }
    .metro-input::placeholder { color: #888; }
    .metro-alert { background: #ff00ff; color: #000; border: none; }
    .metro-alert a { color: #00f3ff; }
    .btn-metro-accent { background: #00f3ff; color: #000; border: none; }
    .btn-metro-accent:hover { background: #33f6ff; }
    .btn-outline-metro { color: #00f3ff; border-color: #00f3ff; background: transparent; }
    .btn-outline-metro:hover { color: #000; background: #00f3ff; }
</style>
